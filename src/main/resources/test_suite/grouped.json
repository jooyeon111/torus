    { "config": "2.dot_product_systolic_array.json",                  "gemm": "gemm(4,4,16).json",      "case": "grouped-noacc" },
    { "config": "3.sub_array_systolic_array.json",                    "gemm": "gemm(16,16,16).json",    "case": "grouped-noacc" },
    { "config": "4.sub_array_dot_product_systolic_array.json",        "gemm": "gemm(16,16,64).json",    "case": "grouped-noacc" },

    { "config": "1.conventional_systolic_array_acc.json",             "gemm": "gemm(16,16,16).json",    "case": "grouped-acc"   },
    { "config": "2.dot_product_systolic_array_acc.json",              "gemm": "gemm(16,16,16).json",    "case": "grouped-acc"   },
    { "config": "3.sub_array_systolic_array_acc.json",                "gemm": "gemm(32,32,32).json",    "case": "grouped-acc"   },
    { "config": "4.sub_array_dot_product_systolic_array_acc.json",    "gemm": "gemm(256,256,256).json", "case": "grouped-acc"   }
  ]
